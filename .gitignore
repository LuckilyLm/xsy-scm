# Project-local agent skills and installation metadata
.agents/
skills-lock.json
.claude
.workbuddy-ai
.commandcode
# WorkBuddy 本地会话数据与工作记忆：只留在本机，不作为项目源码入库。
# 目录本身不要删除，只是不进版本库。
.workbuddy/

# 本地临时工作目录（构建备份、测试产物、一次性截图脚本等）。
# 只在本机保留，任何 .codex- 前缀的目录都不入库。
.codex-*/

# 工程技能的本地工作区（to-spec / to-tickets 产出的 spec 与工单）。
# 只放本次工作的分解与草稿；需要长期留存的结论进 docs/decisions.md，状态进 docs/status.md。
# 若希望工单随仓库共享，删掉这一行即可。
.scratch/

# Local IDE metadata
.idea/
.vscode

# Local environment inventory (machine-specific, never commit)
local-environment-info.txt

# Local tooling (machine-specific, keep out of repository)
# 其余脚本仍含本机绝对路径或明文种子口令（dev_up.sh / verify_screen.mjs 等），脱敏后再评估；
# 只放行共享校验链（verify / ratchet / 迁移校验和守卫及其快照）、Playwright 账号与报表夹具入口，
# 以及下面三个 E2E xlsx 夹具生成器（只按 argv 收文件路径，无本机路径与凭据；不入库则干净检出
# 跑不了商品导入与盘点模板回导用例）。
/tools/*
!/tools/ts_baseline_ratchet.py
!/tools/verify.py
!/tools/README.md
!/tools/test_verification.py
!/tools/migration_checksum_guard.py
!/tools/migration_checksum_snapshot.json
!/tools/e2e_accounts.py
!/tools/e2e_report_fixture.py
!/tools/patch_product_create_xlsx.py
!/tools/patch_product_update_xlsx.py
!/tools/fill_stocktake_template.py
!/tools/requirements-dev.txt
# Java 质量门禁：守卫脚本、Java 源分段器、Checkstyle 规则与 baseline 都必须入库，
# 否则干净检出跑不了 `python tools/verify.py quality`。
# `/tools/*` 排除的是目录本身，所以必须先放行目录，里面的文件才不会被一并忽略。
!/tools/quality/

# Python 字节码（tools/quality 被上面整目录放行，必须单独排除）
__pycache__/
*.pyc

# 本地参考资料（蔬东坡 17.4 操作手册 PDF、流程图等），只留本地不入库
/docs/reference/

# Build outputs and local environment files
**/target/
**/node_modules/
**/dist/
**/.impeccable
# dist-verify 是 `vite build --outDir dist-verify` 的构建产物，会随源码漂移，
# 不应被跟踪（历史上一度入库，内容长期滞后于源码）。需要时本地重新构建即可。
**/dist-verify/
.env
.env.*
!.env.example
!/xsy-scm-web/.env.production
*.log
.playwright-cli/
**/test-results/
**/playwright-report/
**/playwright/.auth/
**/.runtime/

# Keep local deployment state private; include only root Compose build assets.
/deploy/*
!/deploy/README.md
!/deploy/minio/
/deploy/minio/*
!/deploy/minio/bootstrap.sh

# 质量工具单测的临时工作目录（必须在仓库根下，见 test_package_migration_manifest.py）
.tmp-quality-*/
