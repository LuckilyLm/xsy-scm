# Project-local agent skills and installation metadata
.agents/
skills-lock.json
.claude
.workbuddy-ai
.commandcode

# Local IDE metadata
.idea/
.vscode

# Local environment inventory (machine-specific, never commit)
local-environment-info.txt

# Local tooling (machine-specific, keep out of repository)
# 其余脚本仍含本机绝对路径或明文种子口令（dev_up.sh / verify_screen.mjs 等），脱敏后再评估；
# 只放行共享校验链（verify / ratchet / 迁移校验和守卫及其快照）与 Playwright 临时账号脚本。
/tools/*
!/tools/ts_baseline_ratchet.py
!/tools/verify.py
!/tools/test_verification.py
!/tools/migration_checksum_guard.py
!/tools/migration_checksum_snapshot.json
!/tools/e2e_accounts.py
!/tools/w1_e2e_accounts.py
!/tools/w2_e2e_accounts.py
!/tools/w3_e2e_accounts.py
!/tools/w4_e2e_accounts.py
!/tools/w5_e2e_accounts.py
!/tools/w6_e2e_accounts.py

# Reference environment configs contain credentials
/project-reference-examples/xsy-scm/xsy-scm-server/xsy-scm-base/src/main/resources/*/sa-base.yaml

# 本地参考资料（蔬东坡 17.4 操作手册 PDF、流程图等），只留本地不入库
/docs/reference/

# Build outputs and local environment files
**/target/
**/node_modules/
**/dist/
# dist-verify 是 `vite build --outDir dist-verify` 的构建产物，会随源码漂移，
# 不应被跟踪（历史上一度入库，内容长期滞后于源码）。需要时本地重新构建即可。
**/dist-verify/
.env
.env.*
!.env.example
!/xsy-scm-web/.env.production
*.log
.playwright-cli/
**/test-results/
**/playwright-report/
**/playwright/.auth/
**/.runtime/

# Keep local deployment state private; include only root Compose build assets.
/deploy/*
!/deploy/minio/
/deploy/minio/*
!/deploy/minio/bootstrap.sh
