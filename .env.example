TAG=v1
MAVEN_PROFILE=prod

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=7515
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=1024

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=xsy_scm
POSTGRES_USER=xsy_scm_app
POSTGRES_PASSWORD=CHANGE_ME

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=CHANGE_ME

# 官方现成镜像，无需 Linux 服务器编译；版本限制见 README。
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=xsy_scm
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_PASSWORD
MINIO_BUCKET=xsy-scm-test
MINIO_BIND_ADDRESS=0.0.0.0
MINIO_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
# 必填：浏览器和 backend 容器均可访问的地址，不带末尾斜线。
# 使用服务器 LAN IP 或域名；不能使用 localhost、127.0.0.1 或 minio 服务名。
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

JAVA_OPTS=-Xms512m -Xmx1024m
