TAG=v1
MAVEN_PROFILE=prod

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=7515
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=1024

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=xsy_scm
POSTGRES_USER=xsy_scm_app
POSTGRES_PASSWORD=CHANGE_ME

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=CHANGE_ME

# 必填：替换为已安全审查的固定镜像；不要用漂移标签或未修复的示例版本。
MINIO_IMAGE=REPLACE_WITH_REVIEWED_IMMUTABLE_IMAGE
# 必填：minio-bootstrap 用的 mc 客户端镜像（与 MINIO_IMAGE 同一发布渠道）。
MINIO_MC_IMAGE=REPLACE_WITH_REVIEWED_IMMUTABLE_MC_IMAGE
MINIO_ROOT_USER=xsy_scm
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_PASSWORD
MINIO_BUCKET=xsy-scm-test
# MinIO 必须绑定到浏览器能访问的地址。只绑 127.0.0.1 时，若 endpoint 用的是解析到
# 局域网 IP 的名字（如 host.docker.internal），浏览器会连不上，表现为「上传成功但图片显示不出来」。
MINIO_BIND_ADDRESS=0.0.0.0
MINIO_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
# 必填：浏览器和 backend 容器均可访问的地址，不带末尾斜线。
# S3 Client 与 Presigner 共用这一个地址，所以两侧必须都能解析并连上：
#   · 不能用 127.0.0.1 / localhost —— 容器内它指向容器自己；
#   · 不能用 minio —— 宿主/浏览器解析不了这个 compose 服务名；
#   · 本机 Docker Desktop 可用 http://host.docker.internal:9000
#     （容器解析成 Docker 网关，宿主解析成宿主 IP，两侧都通）；
#   · 生产用真实域名，如 https://files.example.com（需自行保证解析、证书与容器回连）。
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

JAVA_OPTS=-Xms512m -Xmx1024m

# prod profile 的 spring.mail 没有默认值，缺失会让上下文启动失败。
# 健康检查里 mail 是关闭的，占位值即可；要真实发信再填正式账号。
XSY_MAIL_HOST=127.0.0.1
XSY_MAIL_PORT=465
XSY_MAIL_USERNAME=xsy-scm@localhost
XSY_MAIL_PASSWORD=CHANGE_ME

# 必填：盘点快照签名密钥。pre/prod 下缺失或等于仓库内公开默认值会让
# StocktakeSnapshotSigner 直接抛错、拒绝启动（这是有意的安全门禁）。
# 生成方式示例：python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(48)).decode())"
SCM_INVENTORY_STOCKTAKE_SNAPSHOT_SECRET=CHANGE_ME_RANDOM_PRIVATE_VALUE
