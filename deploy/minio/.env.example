# LOCAL DEVELOPMENT ONLY. Public sample credentials; NEVER use in pre/prod.
# Copy to deploy/minio/.env (gitignored). Compose has NO credential fallback.
MINIO_BIND_ADDRESS=127.0.0.1
XSY_FILE_STORAGE_MODE=cloud
XSY_FILE_REGION=us-east-1
XSY_FILE_ENDPOINT=http://127.0.0.1:9000
XSY_FILE_BUCKET=xsy-scm-dev
XSY_FILE_ACCESS_KEY=xsy_f0_local
XSY_FILE_SECRET_KEY=xsy-f0-local-only-change-me
XSY_FILE_PATH_STYLE=true
XSY_FILE_SEND_OBJECT_ACL=false
XSY_FILE_PUBLIC_URL_PREFIX=http://127.0.0.1:9000/xsy-scm-dev/
XSY_FILE_PRIVATE_URL_EXPIRE=600
