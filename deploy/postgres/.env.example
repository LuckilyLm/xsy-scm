# 复制为 .env 后按需覆盖。默认值与 sa-base 的 test/dev profile 一致，
# 因此不改任何一项也能直接 `docker compose up -d`。
#
# POSTGRES_DB=xsy_scm
# POSTGRES_USER=xsy_scm_app
# POSTGRES_PASSWORD=
# POSTGRES_HOST_AUTH_METHOD=trust
# 使用密码时必须显式改为 scram-sha-256，仅删除此变量仍会回退到 trust。
# POSTGRES_BIND_ADDRESS=127.0.0.1
# POSTGRES_PORT=15432
