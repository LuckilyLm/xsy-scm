<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xsy.scm</groupId>
        <artifactId>xsy-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>xsy-admin</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>xsy-admin</name>
    <description>xsy-admin project</description>

    <dependencies>

        <dependency>
            <groupId>com.xsy.scm</groupId>
            <artifactId>xsy-base</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 分层与跨域边界的可执行规则，见 ScmArchitectureTest -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <!-- 增量构建可能残留旧资源；只打包当前模块链，不带退役SQL。 -->
                    <excludes>
                        <exclude>db/migration/*.sql</exclude>
                        <exclude>db/migration-history/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.xsy.scm.admin.XsyApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
