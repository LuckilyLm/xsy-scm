<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.balance.dao.CustomerBalanceRechargeDao">

    <select id="selectByIdForUpdate" resultType="com.xsy.scm.balance.domain.entity.CustomerBalanceRechargeEntity">
        SELECT * FROM customer_balance_recharge
        WHERE id = #{rechargeId}
          AND deleted = FALSE
        FOR UPDATE
    </select>

</mapper>
