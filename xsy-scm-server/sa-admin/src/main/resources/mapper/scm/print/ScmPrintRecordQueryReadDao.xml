<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.print.dao.ScmPrintRecordQueryReadDao">
    <!-- 列表不带快照正文：快照可能很大，而列表只需要「谁在什么时候按哪份模板的哪一版打了哪张单」。 -->
    <select id="queryPage" resultType="com.xsy.scm.print.domain.vo.ScmPrintRecordVO">
        SELECT id, document_type, business_id, business_no, template_id, template_code, template_name,
               template_version, printed_at, printed_by
        FROM scm_print_record r
        WHERE 1 = 1
        <choose>
            <when test="scope == null or visibleTypes == null or visibleTypes.isEmpty()">AND FALSE</when>
            <otherwise>
                AND document_type IN
                <foreach collection="visibleTypes" item="type" open="(" separator="," close=")">#{type}</foreach>
                AND (
                    (document_type = 'PURCHASE_ORDER' AND EXISTS (
                        SELECT 1 FROM purchase_order p WHERE p.id = r.business_id AND p.deleted = FALSE
                        <choose>
                            <when test="scope.purchaserScope.empty">AND FALSE</when>
                            <when test="scope.purchaserScope.all == false">
                                AND p.purchaser_id IN
                                <foreach collection="scope.purchaserScope.ids" item="owner" open="(" separator="," close=")">#{owner}</foreach>
                            </when>
                        </choose>
                    ))
                    OR (document_type = 'DELIVERY_NOTE' AND EXISTS (
                        SELECT 1 FROM delivery_route d WHERE d.id = r.business_id AND d.deleted = FALSE
                        <choose>
                            <when test="scope.driverScope.empty">AND FALSE</when>
                            <when test="scope.driverScope.all == false">
                                AND d.driver_id IN
                                <foreach collection="scope.driverScope.ids" item="driver" open="(" separator="," close=")">#{driver}</foreach>
                            </when>
                        </choose>
                    ))
                    OR (document_type = 'SORTING_TICKET' AND EXISTS (
                        SELECT 1 FROM sorting_task t WHERE t.id = r.business_id AND t.deleted = FALSE
                        <include refid="com.xsy.scm.sorting.dao.SortingQueryDao.taskScopeGuard"/>
                    ))
                )
            </otherwise>
        </choose>
        <if test="query.documentType != null and query.documentType != ''">
            AND document_type = #{query.documentType}
        </if>
        <if test="query.businessNo != null and query.businessNo != ''">
            AND business_no ILIKE CONCAT('%', #{query.businessNo}, '%')
        </if>
        ORDER BY printed_at DESC, id DESC
    </select>

</mapper>
