<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.finance.dao.FinanceWaiverDao">

    <select id="nextWaiverNo" resultType="long">
        SELECT nextval('finance_waiver_no_seq')
    </select>

    <select id="selectByIdForUpdate" resultType="com.xsy.scm.finance.domain.entity.FinanceWaiverEntity">
        SELECT *
        FROM xsy_finance_waiver
        WHERE id = #{waiverId}
            AND deleted = FALSE
        FOR UPDATE
    </select>

</mapper>
