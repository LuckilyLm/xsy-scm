<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.scm.finance.dao.FinanceReceiptSourceDao">

    <!--
      财务域对客户表只读：本文件只有 SELECT。
      范围判定要拿到 seller_id 才能判 customerSellerScope，因此一次读足两列，
      不在服务层再走 CustomerService（那会带来第二套校验与写能力）。
    -->
    <select id="selectCustomer"
            resultType="net.lab1024.sa.admin.module.scm.finance.domain.dto.FinanceCustomerFactDto">
        SELECT c.id         AS customerId,
               c.name       AS customerName,
               c.seller_id  AS sellerId
        FROM customer c
        WHERE c.id = #{customerId}
          AND c.deleted = FALSE
    </select>
</mapper>
