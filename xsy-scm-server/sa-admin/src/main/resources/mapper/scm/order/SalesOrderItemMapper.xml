<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.scm.order.dao.SalesOrderItemDao">
    <update id="softDelete">UPDATE sales_order_item
                            SET deleted= TRUE,
                                version=version + 1,
                                updated_at=CURRENT_TIMESTAMP,
                                updated_by=#{operator}
                            WHERE id = #{id}
                              AND version = #{version}
                              AND deleted = FALSE</update>
    <resultMap id="row" type="net.lab1024.sa.admin.module.scm.order.domain.entity.SalesOrderItemEntity">
        <result column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="spu_id" property="spuId"/>
        <result column="sku_id" property="skuId"/>
        <result column="spu_code_snapshot" property="spuCodeSnapshot"/>
        <result column="product_name_snapshot" property="productNameSnapshot"/>
        <result column="sku_code_snapshot" property="skuCodeSnapshot"/>
        <result column="spec_name_snapshot" property="specNameSnapshot"/>
        <result column="spec_values_snapshot" property="specValuesSnapshot"
                typeHandler="net.lab1024.sa.admin.module.scm.order.support.OrderJsonbTypeHandler"/>
        <result column="sale_unit_snapshot" property="saleUnitSnapshot"/>
        <result column="product_type_snapshot" property="productTypeSnapshot"/>
        <result column="ordered_quantity" property="orderedQuantity"/>
        <result column="actual_quantity" property="actualQuantity"/>
        <result column="actual_quantity_source" property="actualQuantitySource"/>
        <result column="actual_quantity_reason" property="actualQuantityReason"/>
        <result column="draft_unit_price" property="draftUnitPrice"/>
        <result column="draft_price_source" property="draftPriceSource"/>
        <result column="draft_price_source_id" property="draftPriceSourceId"/>
        <result column="manual_price_override" property="manualPriceOverride"/>
        <result column="manual_price_reason" property="manualPriceReason"/>
        <result column="locked_unit_price" property="lockedUnitPrice"/>
        <result column="locked_price_source" property="lockedPriceSource"/>
        <result column="locked_price_source_id" property="lockedPriceSourceId"/>
        <result column="ordered_line_amount" property="orderedLineAmount"/>
        <result column="settlement_line_amount" property="settlementLineAmount"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>
    <select id="lock" resultMap="row">SELECT *
                                      FROM sales_order_item
                                      WHERE id = #{id}
                                        AND deleted = FALSE FOR UPDATE</select>
    <select id="list" resultMap="row">SELECT *
                                      FROM sales_order_item
                                      WHERE order_id = #{id}
                                        AND deleted = FALSE
                                      ORDER BY id</select>

    <!--
      Wave 3 §7.5「最近已确认订单价」（只读）：按 (customer, sku) 取历史 CONFIRMED 订单行的锁定单价与单位快照。
      只取未删除的 CONFIRMED 单（排除 DRAFT / PENDING / CANCELLED），不做 locked_unit_price 非空过滤，
      锁定价异常缺失时以 null 展示而非用草稿价 / 当前价兜底；limit 约束「最近 N 张包含该 SKU 的订单」而非行数，
      由分组子查询先定 N 张单，再返回这些单的匹配明细（同单同 SKU 多行各自成行，带 itemId，不任取 / 相加 / 求平均）。
      排序 confirmed_at DESC, order_id DESC 稳定。纯读快照，不回算当前价格、不参与 PriceResolver 定价。
    -->
    <select id="recentPrices"
            resultType="net.lab1024.sa.admin.module.scm.order.domain.vo.OrderRecentPriceVO">
        SELECT i.id                  AS item_id,
               o.id                  AS order_id,
               o.order_no            AS order_no,
               o.created_at          AS created_at,
               o.confirmed_at        AS confirmed_at,
               o.order_source        AS order_source,
               i.ordered_quantity    AS ordered_quantity,
               i.locked_unit_price   AS unit_price,
               i.locked_price_source AS price_source,
               i.sale_unit_snapshot  AS sale_unit
        FROM sales_order o
                 JOIN sales_order_item i ON i.order_id = o.id AND i.deleted = FALSE AND i.sku_id = #{skuId}
        WHERE o.deleted = FALSE
          AND o.status = 'CONFIRMED'
          AND o.customer_id = #{customerId}
          AND o.id IN (SELECT o2.id
                       FROM sales_order o2
                                JOIN sales_order_item i2
                                     ON i2.order_id = o2.id AND i2.deleted = FALSE AND i2.sku_id = #{skuId}
                       WHERE o2.deleted = FALSE
                         AND o2.status = 'CONFIRMED'
                         AND o2.customer_id = #{customerId}
                       GROUP BY o2.id, o2.confirmed_at
                       ORDER BY o2.confirmed_at DESC, o2.id DESC
                       LIMIT #{limit})
        ORDER BY o.confirmed_at DESC, o.id DESC, i.id
    </select>
</mapper>
