<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.order.dao.OrderRefundDao">
    <resultMap id="row" type="com.xsy.scm.order.domain.entity.OrderRefundEntity">
        <result column="id" property="id"/>
        <result column="refund_no" property="refundNo"/>
        <result column="return_id" property="returnId"/>
        <result column="order_id" property="orderId"/>
        <result column="customer_id" property="customerId"/>
        <result column="refund_amount" property="refundAmount"/>
        <result column="status" property="status"/>
        <result column="external_reference" property="externalReference"/>
        <result column="completed_at" property="completedAt"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>
    <select id="lock" resultMap="row">SELECT *
                                      FROM xsy_order_refund
                                      WHERE id = #{id}
                                        AND deleted = FALSE FOR UPDATE</select>
    <!-- 与退货单同口径：xsy_order_refund 无 owner 列，可见性跟随父订单的 xsy_sales_order.seller_id（子查询，不放大行数）。 -->
    <select id="query" resultMap="row">SELECT * FROM xsy_order_refund WHERE deleted=FALSE
        <choose>
            <when test="scope == null or scope.empty">AND FALSE</when>
            <when test="scope.all"></when>
            <otherwise>
                AND order_id IN (SELECT so.id FROM xsy_sales_order so WHERE so.deleted = FALSE AND so.seller_id IN
                    <foreach collection="scope.ids" item="scopeId" open="(" separator="," close=")">#{scopeId}</foreach>)
            </otherwise>
        </choose>
        <if test="query.customerId != null and query.customerId != ''">AND customer_id=#{query.customerId}</if>
        <if test="query.status != null and query.status != ''">AND status=#{query.status}</if>
        <if test="query.orderId != null">AND order_id=#{query.orderId}</if>
        <if test="query.keyword != null and query.keyword != ''">AND (refund_no ILIKE '%' || #{query.keyword} || '%')
        </if>
        <if test="query.startTime != null">AND created_at &gt;= #{query.startTime}</if>
        <if test="query.endTime != null">AND created_at &lt; #{query.endTime}</if>
        ORDER BY created_at DESC,id DESC
    </select>
    <!-- 归属由调用方判定（商城按退货单客户、后台按父订单负责人），本查询只按 return_id 过滤。 -->
    <select id="listByReturnIds" resultMap="row">
        SELECT * FROM xsy_order_refund
        WHERE return_id IN
        <foreach collection="returnIds" item="returnId" open="(" separator="," close=")">#{returnId}</foreach>
        AND deleted = FALSE
        ORDER BY id
    </select>
</mapper>
