<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.device.dao.ScaleDeviceSessionDao">

    <sql id="columns">
        id, device_id, employee_id, session_token_hash, issued_at, expires_at, ended_at, end_reason
    </sql>

    <select id="selectByTokenHash" resultType="com.xsy.scm.device.domain.entity.ScaleDeviceSessionEntity">
        SELECT
        <include refid="columns"/>
        FROM xsy_scale_device_session
        WHERE session_token_hash = #{sessionTokenHash}
    </select>

    <!-- 只结束仍然有效的会话：已经结束的会话保留原结束原因，不被后续操作覆盖。 -->
    <update id="endActiveSessions">
        UPDATE xsy_scale_device_session
        SET ended_at = #{endedAt}, end_reason = #{reason}
        WHERE device_id = #{deviceId}
            AND ended_at IS NULL
    </update>

</mapper>
