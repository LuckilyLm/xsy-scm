<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.scm.warehouse.dao.WarehouseDao">

    <!-- 显式列出全部列：不用 SELECT *，避免新增列时静默进入自动驼峰映射。 -->
    <select id="queryPage" resultType="net.lab1024.sa.admin.module.scm.warehouse.domain.entity.WarehouseEntity">
        SELECT t.id, t.warehouse_code, t.name, t.status, t.address, t.remark,
        t.province_code, t.province_name, t.city_code, t.city_name,
        t.district_code, t.district_name, t.longitude, t.latitude, t.geom_crs,
        t.version, t.created_at, t.updated_at, t.created_by, t.updated_by
        FROM warehouse t
        WHERE t.deleted = FALSE
        <if test="query.warehouseCode != null and query.warehouseCode != ''">
            AND t.warehouse_code ILIKE CONCAT('%', #{query.warehouseCode}, '%')
        </if>
        <if test="query.name != null and query.name != ''">
            AND t.name ILIKE CONCAT('%', #{query.name}, '%')
        </if>
        <if test="query.status != null and query.status != ''">
            AND t.status = #{query.status}
        </if>
        <!--
          仓库主档按授权范围收窄（P0-H 裁决第 3 条）：非管理员不得从未授权仓库拿到 id、名称或地址。
          `all` 不拼谓词；scope 为空或没有授权值即 AND FALSE —— 与库存族读侧同一条失败关闭口径。
        -->
        <choose>
            <when test="scope == null or scope.empty">AND FALSE</when>
            <when test="scope.all"></when>
            <otherwise>
                AND t.id IN
                <foreach collection="scope.ids" item="warehouseScopeId" open="(" separator="," close=")">
                    #{warehouseScopeId}
                </foreach>
            </otherwise>
        </choose>
    </select>

</mapper>
