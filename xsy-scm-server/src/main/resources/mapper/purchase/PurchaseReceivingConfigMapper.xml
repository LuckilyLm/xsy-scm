<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.purchase.mapper.PurchaseReceivingConfigMapper">
    <select id="selectEnabledValue" resultType="java.lang.String">
        SELECT config_value FROM sys_config
        WHERE config_key = #{key} AND status = 'ENABLED' AND deleted = FALSE
        ORDER BY id LIMIT 1
    </select>
</mapper>
