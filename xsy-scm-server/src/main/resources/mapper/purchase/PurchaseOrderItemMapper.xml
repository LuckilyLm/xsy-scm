<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.purchase.mapper.PurchaseOrderItemMapper">
    <resultMap id="PurchaseOrderItemResultMap" type="com.xianshuyuan.scm.purchase.entity.PurchaseOrderItemEntity">
        <id property="id" column="id"/>
        <result property="purchaseOrderId" column="purchase_order_id"/>
        <result property="spuId" column="spu_id"/>
        <result property="skuId" column="sku_id"/>
        <result property="spuCodeSnapshot" column="spu_code_snapshot"/>
        <result property="productNameSnapshot" column="product_name_snapshot"/>
        <result property="skuCodeSnapshot" column="sku_code_snapshot"/>
        <result property="skuNameSnapshot" column="sku_name_snapshot"/>
        <result property="specValuesSnapshot" column="spec_values_snapshot"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbStringMapTypeHandler"/>
        <result property="purchaseUnitSnapshot" column="purchase_unit_snapshot"/>
        <result property="productTypeSnapshot" column="product_type_snapshot"/>
        <result property="plannedQuantity" column="planned_quantity"/>
        <result property="receivedQuantity" column="received_quantity"/>
        <result property="purchasePrice" column="purchase_price"/>
        <result property="lineAmount" column="line_amount"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="version" column="version"/>
        <result property="deleted" column="deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>
    <select id="selectActiveByOrderId" resultMap="PurchaseOrderItemResultMap">SELECT * FROM purchase_order_item WHERE
        purchase_order_id=#{orderId} AND deleted=FALSE ORDER BY sort_order,id
    </select>
    <select id="selectActiveByOrderIdForUpdate" resultMap="PurchaseOrderItemResultMap">SELECT * FROM purchase_order_item
        WHERE purchase_order_id=#{orderId} AND deleted=FALSE ORDER BY sort_order,id FOR UPDATE
    </select>
    <select id="selectActiveById" resultMap="PurchaseOrderItemResultMap">SELECT * FROM purchase_order_item WHERE
        id=#{id} AND deleted=FALSE
    </select>
    <update id="softDeleteOwnedWithVersion">UPDATE purchase_order_item SET
        deleted=TRUE,version=version+1,updated_at=CURRENT_TIMESTAMP,updated_by='SYSTEM' WHERE
        purchase_order_id=#{orderId} AND id=#{id} AND version=#{version} AND deleted=FALSE
    </update>
    <update id="softDeleteByOrderId">UPDATE purchase_order_item SET
        deleted=TRUE,updated_at=CURRENT_TIMESTAMP,updated_by='SYSTEM' WHERE purchase_order_id=#{orderId} AND
        deleted=FALSE
    </update>
</mapper>
