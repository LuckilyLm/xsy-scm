<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.purchase.mapper.PurchaseOrderMapper">
    <select id="selectActiveById" resultType="com.xianshuyuan.scm.purchase.entity.PurchaseOrderEntity">SELECT *
                                                                                                       FROM purchase_order
                                                                                                       WHERE id = #{id}
                                                                                                         AND deleted = false</select>
    <select id="selectActiveByIdForUpdate" resultType="com.xianshuyuan.scm.purchase.entity.PurchaseOrderEntity">SELECT *
                                                                                                                FROM purchase_order
                                                                                                                WHERE id = #{id}
                                                                                                                  AND deleted = false FOR UPDATE</select>
    <select id="selectActiveList" resultType="com.xianshuyuan.scm.purchase.entity.PurchaseOrderEntity">SELECT *
                                                                                                       FROM purchase_order
                                                                                                       WHERE deleted = false
                                                                                                       ORDER BY id
                                                                                                           DESC</select>
</mapper>
