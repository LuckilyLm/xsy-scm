<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.product.mapper.ProductSkuMapper">

    <resultMap id="SkuResultMap" type="com.xianshuyuan.scm.product.entity.ProductSkuEntity">
        <id property="id" column="id"/>
        <result property="spuId" column="spu_id"/>
        <result property="skuCode" column="sku_code"/>
        <result property="barcode" column="barcode"/>
        <result property="specName" column="spec_name"/>
        <result property="specValues" column="spec_values"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbStringMapTypeHandler"/>
        <result property="saleUnit" column="sale_unit"/>
        <result property="productType" column="product_type"/>
        <result property="marketPrice" column="market_price"/>
        <result property="status" column="status"/>
        <result property="defaultSku" column="is_default"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="version" column="version"/>
        <result property="deleted" column="deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>

    <select id="selectActiveBySpuId" resultMap="SkuResultMap">
        SELECT id, spu_id, sku_code, barcode, spec_name, spec_values, sale_unit,
               product_type, market_price, status, is_default, sort_order,
               version, deleted, created_at, updated_at, created_by, updated_by
        FROM product_sku
        WHERE spu_id = #{spuId} AND deleted = FALSE
        ORDER BY sort_order, id
    </select>

    <select id="selectActiveBySpuIds" resultMap="SkuResultMap">
        SELECT id, spu_id, sku_code, barcode, spec_name, spec_values, sale_unit,
               product_type, market_price, status, is_default, sort_order,
               version, deleted, created_at, updated_at, created_by, updated_by
        FROM product_sku
        WHERE deleted = FALSE
          AND spu_id IN
          <foreach collection="spuIds" item="spuId" open="(" separator="," close=")">
              #{spuId}
          </foreach>
        ORDER BY spu_id, sort_order, id
    </select>

    <update id="clearDefault">
        UPDATE product_sku
        SET is_default = FALSE,
            updated_at = CURRENT_TIMESTAMP,
            updated_by = 'SYSTEM'
        WHERE spu_id = #{spuId}
          AND deleted = FALSE
          AND is_default = TRUE
    </update>
</mapper>
