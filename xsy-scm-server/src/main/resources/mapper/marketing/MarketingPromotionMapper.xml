<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.marketing.mapper.MarketingPromotionMapper">

    <resultMap id="PromotionRowMap" type="com.xianshuyuan.scm.marketing.row.PromotionRow">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="scopeType" column="scope_type"/>
        <result property="scopeIds" column="scope_ids"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbJsonNodeTypeHandler"/>
        <result property="thresholdAmount" column="threshold_amount"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="reduceAmount" column="reduce_amount"/>
        <result property="promoPrice" column="promo_price"/>
        <result property="giftSkuId" column="gift_sku_id"/>
        <result property="giftQuantity" column="gift_quantity"/>
        <result property="limitQuantity" column="limit_quantity"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="description" column="description"/>
    </resultMap>

    <resultMap id="PromotionEntityMap" type="com.xianshuyuan.scm.marketing.entity.MarketingPromotionEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="scopeType" column="scope_type"/>
        <result property="scopeIds" column="scope_ids"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbJsonNodeTypeHandler"/>
        <result property="thresholdAmount" column="threshold_amount"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="reduceAmount" column="reduce_amount"/>
        <result property="promoPrice" column="promo_price"/>
        <result property="giftSkuId" column="gift_sku_id"/>
        <result property="giftQuantity" column="gift_quantity"/>
        <result property="limitQuantity" column="limit_quantity"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="description" column="description"/>
    </resultMap>

    <select id="selectPage" resultMap="PromotionRowMap">
        SELECT id, name, type, scope_type, scope_ids, threshold_amount, discount_rate, reduce_amount,
        promo_price, gift_sku_id, gift_quantity, limit_quantity, start_at, end_at, status, priority, description
        FROM marketing_promotion
        WHERE deleted = FALSE
        <if test="query.keyword != null and query.keyword != ''">
            AND (name ILIKE CONCAT('%', #{query.keyword}, '%')
            OR description ILIKE CONCAT('%', #{query.keyword}, '%'))
        </if>
        <if test="query.type != null and query.type != ''">
            AND type = #{query.type}
        </if>
        <if test="query.status != null and query.status != ''">
            AND status = #{query.status}
        </if>
        ORDER BY priority DESC, created_at DESC
    </select>

    <select id="selectEffective" resultMap="PromotionEntityMap">
        SELECT id, name, type, scope_type, scope_ids, threshold_amount, discount_rate, reduce_amount,
        promo_price, gift_sku_id, gift_quantity, limit_quantity, start_at, end_at, status, priority, description
        FROM marketing_promotion
        WHERE deleted = FALSE
        AND status = 'ENABLED'
        AND (start_at IS NULL OR start_at &lt;= #{now})
        AND (end_at IS NULL OR end_at &gt;= #{now})
        ORDER BY priority DESC, id DESC
    </select>
</mapper>
