<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.marketing.mapper.MarketingHomeSectionMapper">

    <resultMap id="HomeSectionEntityMap" type="com.xianshuyuan.scm.marketing.entity.MarketingHomeSectionEntity">
        <id property="id" column="id"/>
        <result property="sectionType" column="section_type"/>
        <result property="title" column="title"/>
        <result property="promotionId" column="promotion_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="payload" column="payload"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbJsonNodeTypeHandler"/>
    </resultMap>

    <select id="selectActive" resultMap="HomeSectionEntityMap">
        SELECT id, section_type, title, promotion_id, category_id, sort_order, status, start_at, end_at, payload
        FROM marketing_home_section
        WHERE deleted = FALSE
        AND status = 'ENABLED'
        AND (start_at IS NULL OR start_at &lt;= #{now})
        AND (end_at IS NULL OR end_at &gt;= #{now})
        ORDER BY sort_order, id
    </select>
</mapper>
