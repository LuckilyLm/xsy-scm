<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.order.mapper.SalesOrderItemMapper">
    <resultMap id="item" type="com.xianshuyuan.scm.order.entity.SalesOrderItemEntity">
        <id property="id" column="id"/>
        <result property="specValuesSnapshot" column="spec_values_snapshot"
                typeHandler="com.xianshuyuan.scm.common.persistence.JsonbStringMapTypeHandler"/>
    </resultMap>
    <sql id="columns">
        id,order_id,spu_id,sku_id,spu_code_snapshot,product_name_snapshot,sku_code_snapshot,spec_name_snapshot,spec_values_snapshot,sale_unit_snapshot,product_type_snapshot,ordered_quantity,actual_quantity,actual_quantity_source,actual_quantity_reason,draft_unit_price,draft_price_source,draft_price_source_id,manual_price_override,manual_price_reason,locked_unit_price,locked_price_source,locked_price_source_id,ordered_line_amount,settlement_line_amount,sort_order,version,deleted,created_at,updated_at,created_by,updated_by
    </sql>
    <select id="selectActiveByOrderId" resultMap="item">SELECT
        <include refid="columns"/>
        FROM sales_order_item WHERE order_id=#{orderId} AND deleted=FALSE ORDER BY sort_order,id
    </select>
    <select id="selectActiveByOrderIds" resultMap="item">SELECT
        <include refid="columns"/>
        FROM sales_order_item WHERE deleted=FALSE AND order_id IN <foreach collection="orderIds" item="id" open="("
                                                                           separator="," close=")">#{id}
        </foreach> ORDER BY order_id,sort_order,id
    </select>
    <select id="selectActiveByOrderIdForUpdate" resultMap="item">SELECT
        <include refid="columns"/>
        FROM sales_order_item WHERE order_id=#{orderId} AND deleted=FALSE ORDER BY sort_order,id FOR UPDATE
    </select>
    <update id="softDeleteByIds">UPDATE sales_order_item SET
        deleted=TRUE,version=version+1,updated_at=CURRENT_TIMESTAMP,updated_by='SYSTEM' WHERE order_id=#{orderId} AND
        deleted=FALSE AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
