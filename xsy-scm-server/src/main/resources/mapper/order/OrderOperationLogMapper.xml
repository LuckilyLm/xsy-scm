<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.order.mapper.OrderOperationLogMapper">
 <resultMap id="log" type="com.xianshuyuan.scm.order.entity.OrderOperationLogEntity"><id property="id" column="id"/><result property="beforeData" column="before_data" typeHandler="com.xianshuyuan.scm.common.persistence.JsonbJsonNodeTypeHandler"/><result property="afterData" column="after_data" typeHandler="com.xianshuyuan.scm.common.persistence.JsonbJsonNodeTypeHandler"/></resultMap>
 <select id="selectByOrderId" resultMap="log">SELECT id,order_id,operation_type,operator,reason,before_data,after_data,created_at,created_by FROM order_operation_log WHERE order_id=#{orderId} ORDER BY created_at,id</select>
</mapper>
