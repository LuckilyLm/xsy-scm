<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianshuyuan.scm.order.mapper.SalesOrderMapper">
 <sql id="columns">id,order_no,customer_id,customer_code_snapshot,customer_name_snapshot,order_source,original_order_id,supplement_reason,status,ordered_total_amount,settlement_total_amount,cancel_reason,submitted_at,confirmed_at,cancelled_at,version,deleted,created_at,updated_at,created_by,updated_by</sql>
 <select id="selectActiveById" resultType="com.xianshuyuan.scm.order.entity.SalesOrderEntity">SELECT <include refid="columns"/> FROM sales_order WHERE id=#{id} AND deleted=FALSE</select>
 <select id="selectActiveByIdForUpdate" resultType="com.xianshuyuan.scm.order.entity.SalesOrderEntity">SELECT <include refid="columns"/> FROM sales_order WHERE id=#{id} AND deleted=FALSE FOR UPDATE</select>
</mapper>
