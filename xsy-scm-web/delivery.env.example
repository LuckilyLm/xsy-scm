# Copy into the selected Vite mode's local environment file, e.g. .env.localhost.local.
# Key for the Web JSAPI application (domain allowlist configured in AMap console).
VITE_AMAP_KEY=
# Production: proxy URL terminating in /_AMapService. Keep security code on the proxy server.
VITE_AMAP_SERVICE_HOST=
# Development only if a proxy is unavailable; VITE_* values are public build-time variables.
VITE_AMAP_SECURITY_CODE=
