{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": true,
    "types": ["node"],
    "paths": {
      "/@/plugins/xsy-enums-plugin": ["./e2e/types/xsy-enums-plugin.d.ts"],
      "/@/*": ["./src/*"]
    }
  },
  "include": ["e2e/**/*.ts", "e2e-chains/**/*.ts", "playwright.config.ts", "playwright.chains.config.ts"]
}
