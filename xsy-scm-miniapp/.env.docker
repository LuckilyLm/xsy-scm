# H5 容器化部署专用环境（`uni build --mode docker`）
# 注意：当前仓库的 Dockerfile.web 只构建 xsy-scm-web，小程序/H5 尚未接入容器构建。
# 若将来把 H5 产物放进 Nginx，用这个 mode：同源 /api 由 Nginx 反代到后端容器。
NODE_ENV=production
VITE_APP_TITLE='鲜蔬源商城'
VITE_APP_API_URL='/api'

# 生产 / 测试构建一律关闭 mock，假数据不得进入产物（vite.config.js 会把 @/mock 别名到空实现）。
VITE_APP_USE_MOCK=false
