{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^y-(.*)": "@/uni_modules/y-$1/components/y-$1.vue"
    }
  },

  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/category/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "分类"
      }
    },
    {
      "path": "pages/cart/index",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/order/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "订单",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    }
  ],

  "subPackages": [
    {
      "root": "pages-sub/auth",
      "pages": [
        {
          "path": "bind",
          "style": { "navigationBarTitleText": "客户绑定" }
        }
      ]
    },
    {
      "root": "pages-sub/product",
      "pages": [
        {
          "path": "search",
          "style": { "navigationBarTitleText": "搜索" }
        },
        {
          "path": "detail",
          "style": { "navigationBarTitleText": "商品详情" }
        }
      ]
    },
    {
      "root": "pages-sub/checkout",
      "pages": [
        {
          "path": "index",
          "style": { "navigationBarTitleText": "结算" }
        },
        {
          "path": "success",
          "style": { "navigationBarTitleText": "下单成功" }
        }
      ]
    },
    {
      "root": "pages-sub/address",
      "pages": [
        {
          "path": "list",
          "style": { "navigationBarTitleText": "收货地址" }
        },
        {
          "path": "edit",
          "style": { "navigationBarTitleText": "编辑地址" }
        }
      ]
    },
    {
      "root": "pages-sub/order",
      "pages": [
        {
          "path": "detail",
          "style": { "navigationBarTitleText": "订单详情" }
        },
        {
          "path": "delivery",
          "style": { "navigationBarTitleText": "配送详情" }
        },
        {
          "path": "weigh",
          "style": { "navigationBarTitleText": "实重明细" }
        }
      ]
    },
    {
      "root": "pages-sub/favorite",
      "pages": [
        {
          "path": "index",
          "style": { "navigationBarTitleText": "常购商品" }
        },
        {
          "path": "reorder",
          "style": { "navigationBarTitleText": "再来一单" }
        }
      ]
    },
    {
      "root": "pages-sub/promotion",
      "pages": [
        {
          "path": "flash-sale",
          "style": { "navigationBarTitleText": "限时抢购" }
        }
      ]
    },
    {
      "root": "pages-sub/account",
      "pages": [
        {
          "path": "profile",
          "style": { "navigationBarTitleText": "客户资料" }
        },
        {
          "path": "credit",
          "style": { "navigationBarTitleText": "账期" }
        },
        {
          "path": "balance",
          "style": { "navigationBarTitleText": "余额" }
        },
        {
          "path": "coupon",
          "style": { "navigationBarTitleText": "优惠券" }
        },
        {
          "path": "bill",
          "style": { "navigationBarTitleText": "对账" }
        },
        {
          "path": "stat",
          "style": { "navigationBarTitleText": "下单统计" }
        },
        {
          "path": "message",
          "style": { "navigationBarTitleText": "消息通知" }
        },
        {
          "path": "terms",
          "style": { "navigationBarTitleText": "服务条款" }
        },
        {
          "path": "after-sale-rule",
          "style": { "navigationBarTitleText": "售后规则" }
        },
        {
          "path": "about",
          "style": { "navigationBarTitleText": "关于我们" }
        },
        {
          "path": "setting",
          "style": { "navigationBarTitleText": "设置" }
        }
      ]
    }
  ],

  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages-sub/product"]
    }
  },

  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "鲜蔬源商城",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6F8"
  },

  "tabBar": {
    "color": "#8F959E",
    "selectedColor": "#16A34A",
    "borderStyle": "white",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/home/index",
        "iconPath": "static/images/tabbar/home.png",
        "selectedIconPath": "static/images/tabbar/home-h.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/category/index",
        "iconPath": "static/images/tabbar/category.png",
        "selectedIconPath": "static/images/tabbar/category-h.png",
        "text": "分类"
      },
      {
        "pagePath": "pages/cart/index",
        "iconPath": "static/images/tabbar/cart.png",
        "selectedIconPath": "static/images/tabbar/cart-h.png",
        "text": "购物车"
      },
      {
        "pagePath": "pages/order/index",
        "iconPath": "static/images/tabbar/order.png",
        "selectedIconPath": "static/images/tabbar/order-h.png",
        "text": "订单"
      },
      {
        "pagePath": "pages/mine/index",
        "iconPath": "static/images/tabbar/mine.png",
        "selectedIconPath": "static/images/tabbar/mine-h.png",
        "text": "我的"
      }
    ]
  }
}
