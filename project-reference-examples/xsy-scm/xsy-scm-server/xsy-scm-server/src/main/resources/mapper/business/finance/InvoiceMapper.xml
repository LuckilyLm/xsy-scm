<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.finance.dao.InvoiceDao">

    <!-- 分页查询发票 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.finance.domain.vo.InvoiceVO">
        SELECT
            invoice_id,
            invoice_no,
            order_id,
            relate_invoice_nos,
            amount,
            tax_rate,
            status,
            create_time,
            update_time
        FROM t_invoice
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.orderId != null">
                AND order_id = #{queryForm.orderId}
            </if>
            <if test="queryForm.status != null">
                AND status = #{queryForm.status}
            </if>
            <if test="queryForm.searchWord != null and queryForm.searchWord != ''">
                AND INSTR(invoice_no, #{queryForm.searchWord})
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY invoice_id DESC
        </if>
    </select>

    <!-- 按订单查询发票（整单红冲联动） -->
    <select id="listByOrderId" resultType="com.xsy.scm.admin.module.business.finance.domain.entity.InvoiceEntity">
        SELECT
            invoice_id,
            invoice_no,
            order_id,
            relate_invoice_nos,
            amount,
            tax_rate,
            status,
            deleted_flag
        FROM t_invoice
        WHERE order_id = #{orderId}
          AND deleted_flag = 0
        ORDER BY invoice_id ASC
    </select>

    <!-- 批量更新删除状态 -->
    <update id="batchUpdateDeleted">
        update t_invoice
        set deleted_flag = #{deletedFlag}
        WHERE invoice_id IN
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

</mapper>
