<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.product.dao.ProductSupplierDao">

    <!-- 分页查询商品-供应商关系 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.product.domain.vo.ProductSupplierVO">
        SELECT
            id,
            product_id,
            supplier_id,
            supply_price,
            default_flag,
            create_time,
            update_time
        FROM t_product_supplier
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.productId != null">
                AND product_id = #{queryForm.productId}
            </if>
            <if test="queryForm.supplierId != null">
                AND supplier_id = #{queryForm.supplierId}
            </if>
            <if test="queryForm.defaultFlag != null">
                AND default_flag = #{queryForm.defaultFlag}
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY id DESC
        </if>
    </select>

    <!-- 批量更新删除状态 -->
    <update id="batchUpdateDeleted">
        update t_product_supplier
        set deleted_flag = #{deletedFlag}
        WHERE id IN
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

</mapper>
