<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.finance.dao.PaymentDao">

    <!-- 分页查询收款单 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.finance.domain.vo.PaymentVO">
        SELECT
            payment_id,
            payment_no,
            order_id,
            receivable_id,
            customer_id,
            amount,
            pay_channel,
            pay_time,
            proof_image,
            status,
            remark,
            create_time
        FROM t_payment
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.paymentNo != null and queryForm.paymentNo != ''">
                AND payment_no LIKE CONCAT('%', #{queryForm.paymentNo}, '%')
            </if>
            <if test="queryForm.customerId != null">
                AND customer_id = #{queryForm.customerId}
            </if>
            <if test="queryForm.status != null">
                AND status = #{queryForm.status}
            </if>
        </where>
        ORDER BY payment_id DESC
    </select>

</mapper>
