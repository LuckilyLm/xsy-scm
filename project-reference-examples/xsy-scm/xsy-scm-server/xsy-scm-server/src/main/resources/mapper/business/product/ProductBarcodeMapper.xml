<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.product.dao.ProductBarcodeDao">

    <!-- 分页查询商品条码 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.product.domain.vo.ProductBarcodeVO">
        SELECT
            barcode_id,
            product_id,
            sku_id,
            barcode,
            unit,
            create_time,
            update_time
        FROM t_product_barcode
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.productId != null">
                AND product_id = #{queryForm.productId}
            </if>
            <if test="queryForm.searchWord != null and queryForm.searchWord != ''">
                AND INSTR(barcode, #{queryForm.searchWord})
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY barcode_id DESC
        </if>
    </select>

    <!-- 按条码查询（扫码入口 + 唯一性校验） -->
    <select id="getByBarcode" resultType="com.xsy.scm.admin.module.business.product.domain.entity.ProductBarcodeEntity">
        SELECT
            barcode_id,
            product_id,
            sku_id,
            barcode,
            unit,
            deleted_flag
        FROM t_product_barcode
        WHERE barcode = #{barcode}
          AND deleted_flag = 0
        LIMIT 1
    </select>

    <!-- 批量更新删除状态 -->
    <update id="batchUpdateDeleted">
        update t_product_barcode
        set deleted_flag = #{deletedFlag}
        WHERE barcode_id IN
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

</mapper>
