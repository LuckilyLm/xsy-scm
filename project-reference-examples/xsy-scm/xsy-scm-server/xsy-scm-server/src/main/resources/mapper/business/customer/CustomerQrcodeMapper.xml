<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.customer.dao.CustomerQrcodeDao">

    <!-- 分页查询推广二维码 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.customer.domain.vo.CustomerQrcodeVO">
        SELECT
            qrcode_id,
            seller_id,
            qrcode_url,
            scan_count,
            create_time,
            update_time
        FROM t_customer_qrcode
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.sellerId != null">
                AND seller_id = #{queryForm.sellerId}
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY qrcode_id DESC
        </if>
    </select>

    <!-- 批量更新删除状态 -->
    <update id="batchUpdateDeleted">
        update t_customer_qrcode
        set deleted_flag = #{deletedFlag}
        WHERE qrcode_id IN
        <foreach collection="qrcodeIdList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

</mapper>
