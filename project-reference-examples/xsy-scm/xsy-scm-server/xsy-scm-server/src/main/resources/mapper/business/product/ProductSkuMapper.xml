<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsy.scm.admin.module.business.product.dao.ProductSkuDao">

    <!-- 分页查询商品规格 -->
    <select id="queryPage" resultType="com.xsy.scm.admin.module.business.product.domain.vo.ProductSkuVO">
        SELECT
            sku_id,
            product_id,
            sku_no,
            spec_name,
            unit,
            unit_weight,
            status,
            create_time,
            update_time
        FROM t_product_sku
        <where>
            <if test="queryForm.deletedFlag != null">
                AND deleted_flag = #{queryForm.deletedFlag}
            </if>
            <if test="queryForm.productId != null">
                AND product_id = #{queryForm.productId}
            </if>
            <if test="queryForm.searchWord != null and queryForm.searchWord != ''">
                AND INSTR(spec_name, #{queryForm.searchWord})
            </if>
            <if test="queryForm.status != null">
                AND status = #{queryForm.status}
            </if>
        </where>
        <if test="queryForm.sortItemList == null or queryForm.sortItemList.size == 0">
            ORDER BY sku_id DESC
        </if>
    </select>

    <!-- 回填规格编码 -->
    <update id="updateSkuNo">
        update t_product_sku
        set sku_no = #{skuNo}
        where sku_id = #{skuId}
    </update>

    <!-- 批量更新删除状态 -->
    <update id="batchUpdateDeleted">
        update t_product_sku
        set deleted_flag = #{deletedFlag}
        WHERE sku_id IN
        <foreach collection="skuIdList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

</mapper>
