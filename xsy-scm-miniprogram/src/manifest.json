{
    "name" : "鲜蔬园微信小程序",
    "appid" : "",
    "description" : "鲜蔬园智链 · 给用户使用的微信小程序",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 小程序特有相关 */
    "mp-weixin" : {
        /* 业主提供的小程序 AppID；未填写时微信开发者工具只能用测试号打开 */
        "appid" : "wx66cd53ccf2e037c9",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true,
        /* 按需注入：启动时只注入当前页面用到的组件代码，缩短冷启动 */
        "lazyCodeLoading" : "requiredComponents",
        /* 分包优化：分包内的静态资源与 JS 不重复计入主包 */
        "optimization" : {
            "subPackages" : true
        },
        /* 收货地址需要取当前位置，未声明时 getLocation / chooseLocation 直接失败 */
        "permission" : {
            "scope.userLocation" : {
                "desc" : "用于获取收货地址的位置信息"
            }
        },
        "requiredPrivateInfos" : [ "getLocation", "chooseLocation" ],
        /* 启用微信隐私协议校验，requirePrivacyAuthorize 才会生效 */
        "__usePrivacyCheck__" : true
    },
    "h5" : {
        "title" : "鲜蔬园"
    },
    "uniStatistics" : {
        "enable" : false
    },
    "vueVersion" : "3"
}
