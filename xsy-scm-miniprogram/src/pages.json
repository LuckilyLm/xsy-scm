{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTextStyle": "black",
        "navigationBarTitleText": "首页",
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/category/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "分类",
        "disableScroll": true
      }
    },
    {
      "path": "pages/cart/index",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/order/index",
      "style": {
        "navigationBarTitleText": "订单",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTextStyle": "black",
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/account/password",
      "style": {
        "navigationBarTitleText": "修改密码"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub",
      "pages": [
        {
          "path": "account/profile",
          "style": { "navigationBarTitleText": "个人资料" }
        },
        {
          "path": "product/search",
          "style": {
            "navigationBarTitleText": "搜索",
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "product/detail",
          "style": {
            "navigationBarTitleText": "商品详情",
            "disableScroll": true
          }
        },
        {
          "path": "address/list",
          "style": {
            "navigationBarTitleText": "收货地址"
          }
        },
        {
          "path": "address/edit",
          "style": {
            "navigationBarTitleText": "编辑地址"
          }
        },
        {
          "path": "checkout/index",
          "style": {
            "navigationBarTitleText": "确认订单"
          }
        },
        {
          "path": "checkout/success",
          "style": {
            "navigationBarTitleText": "下单成功"
          }
        },
        {
          "path": "order/detail",
          "style": {
            "navigationBarTitleText": "订单详情",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "order/summary",
          "style": {
            "navigationBarTitleText": "下单商品汇总",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "after-sale/apply",
          "style": {
            "navigationBarTitleText": "申请售后"
          }
        },
        {
          "path": "after-sale/list",
          "style": {
            "navigationBarTitleText": "售后",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "after-sale/detail",
          "style": {
            "navigationBarTitleText": "售后详情",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "wallet/index",
          "style": {
            "navigationBarTitleText": "我的钱包",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "wallet/movements",
          "style": {
            "navigationBarTitleText": "收支记录",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "credit/index",
          "style": {
            "navigationBarTitleText": "账期与账单",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "credit/receivables",
          "style": {
            "navigationBarTitleText": "应收账单",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "credit/detail",
          "style": {
            "navigationBarTitleText": "账单详情",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "promotion/activities",
          "style": {
            "navigationBarTitleText": "商城活动",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "promotion/coupons",
          "style": {
            "navigationBarTitleText": "领券中心",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "promotion/my",
          "style": {
            "navigationBarTitleText": "我的优惠券",
            "enablePullDownRefresh": true,
            "onReachBottomDistance": 80
          }
        },
        {
          "path": "mall/web",
          "style": {
            "navigationBarTitleText": "网页"
          }
        },
        {
          "path": "page/index",
          "style": {
            "navigationBarTitleText": "商城公告"
          }
        },
        {
          "path": "trace/detail",
          "style": {
            "navigationBarTitleText": "溯源信息",
            "enablePullDownRefresh": true
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages-sub"]
    }
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/home/index"
      },
      {
        "name": "商品详情",
        "path": "pages-sub/product/detail",
        "query": "skuId=5000"
      },
      {
        "name": "购物车",
        "path": "pages/cart/index"
      },
      {
        "name": "订单",
        "path": "pages/order/index"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "鲜蔬源",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6F8"
  },
  "tabBar": {
    "color": "#8F959E",
    "selectedColor": "#16A34A",
    "borderStyle": "white",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/category/index",
        "text": "分类"
      },
      {
        "pagePath": "pages/cart/index",
        "text": "购物车"
      },
      {
        "pagePath": "pages/order/index",
        "text": "订单"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的"
      }
    ]
  }
}
