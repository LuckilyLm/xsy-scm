{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/home/index", "style": { "navigationStyle": "custom", "navigationBarTitleText": "首页", "onReachBottomDistance": 80 } },
    { "path": "pages/category/index", "style": { "navigationStyle": "custom", "navigationBarTitleText": "分类" } },
    { "path": "pages/cart/index", "style": { "navigationBarTitleText": "购物车" } },
    { "path": "pages/order/index", "style": { "navigationBarTitleText": "订单", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } },
    { "path": "pages/mine/index", "style": { "navigationStyle": "custom", "navigationBarTitleText": "我的" } },
    { "path": "pages/login/login", "style": { "navigationStyle": "custom", "navigationBarTitleText": "登录" } },
    { "path": "pages/account/password", "style": { "navigationBarTitleText": "修改密码" } }
  ],
  "subPackages": [
    {
      "root": "pages-sub/product",
      "pages": [
        { "path": "search", "style": { "navigationBarTitleText": "搜索", "onReachBottomDistance": 80 } },
        { "path": "detail", "style": { "navigationBarTitleText": "商品详情" } }
      ]
    },
    {
      "root": "pages-sub/address",
      "pages": [
        { "path": "list", "style": { "navigationBarTitleText": "收货地址" } },
        { "path": "edit", "style": { "navigationBarTitleText": "编辑地址" } }
      ]
    },
    {
      "root": "pages-sub/checkout",
      "pages": [
        { "path": "index", "style": { "navigationBarTitleText": "确认订单" } },
        { "path": "success", "style": { "navigationBarTitleText": "下单成功" } }
      ]
    },
    {
      "root": "pages-sub/order",
      "pages": [
        { "path": "detail", "style": { "navigationBarTitleText": "订单详情", "enablePullDownRefresh": true } },
        { "path": "summary", "style": { "navigationBarTitleText": "下单商品汇总", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } }
      ]
    },
    {
      "root": "pages-sub/after-sale",
      "pages": [
        { "path": "apply", "style": { "navigationBarTitleText": "申请售后" } },
        { "path": "list", "style": { "navigationBarTitleText": "售后", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } },
        { "path": "detail", "style": { "navigationBarTitleText": "售后详情", "enablePullDownRefresh": true } }
      ]
    },
    {
      "root": "pages-sub/wallet",
      "pages": [
        { "path": "index", "style": { "navigationBarTitleText": "我的钱包", "enablePullDownRefresh": true } },
        { "path": "movements", "style": { "navigationBarTitleText": "收支记录", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } }
      ]
    },
    {
      "root": "pages-sub/credit",
      "pages": [
        { "path": "index", "style": { "navigationBarTitleText": "账期与账单", "enablePullDownRefresh": true } },
        { "path": "receivables", "style": { "navigationBarTitleText": "应收账单", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } },
        { "path": "detail", "style": { "navigationBarTitleText": "账单详情", "enablePullDownRefresh": true } }
      ]
    },
    {
      "root": "pages-sub/promotion",
      "pages": [
        { "path": "activities", "style": { "navigationBarTitleText": "商城活动", "enablePullDownRefresh": true } },
        { "path": "coupons", "style": { "navigationBarTitleText": "领券中心", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } },
        { "path": "my", "style": { "navigationBarTitleText": "我的优惠券", "enablePullDownRefresh": true, "onReachBottomDistance": 80 } }
      ]
    },
    {
      "root": "pages-sub/mall",
      "pages": [
        { "path": "web", "style": { "navigationBarTitleText": "网页" } }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": { "network": "all", "packages": ["pages-sub/product"] }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "鲜蔬园",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6F8"
  },
  "tabBar": {
    "color": "#8F959E",
    "selectedColor": "#16A34A",
    "borderStyle": "white",
    "backgroundColor": "#FFFFFF",
    "list": [
      { "pagePath": "pages/home/index", "iconPath": "static/images/tabbar/home.png", "selectedIconPath": "static/images/tabbar/home-h.png", "text": "首页" },
      { "pagePath": "pages/category/index", "iconPath": "static/images/tabbar/category.png", "selectedIconPath": "static/images/tabbar/category-h.png", "text": "分类" },
      { "pagePath": "pages/cart/index", "iconPath": "static/images/tabbar/cart.png", "selectedIconPath": "static/images/tabbar/cart-h.png", "text": "购物车" },
      { "pagePath": "pages/order/index", "iconPath": "static/images/tabbar/order.png", "selectedIconPath": "static/images/tabbar/order-h.png", "text": "订单" },
      { "pagePath": "pages/mine/index", "iconPath": "static/images/tabbar/mine.png", "selectedIconPath": "static/images/tabbar/mine-h.png", "text": "我的" }
    ]
  }
}
